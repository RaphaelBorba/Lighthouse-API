{
  "info": {
    "name": "Lighthouse Checkout API",
    "description": "Shopping cart API with promotional pricing rules",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Check if the API is running"
      }
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "description": "List all available products with their SKUs and prices"
          }
        }
      ]
    },
    {
      "name": "Checkout",
      "item": [
        {
          "name": "Scan Item - Google Home",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"120P90\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/checkout/scan",
              "host": ["{{baseUrl}}"],
              "path": ["checkout", "scan"]
            },
            "description": "Add Google Home ($49.99) to cart. Buy 3, pay for 2!"
          }
        },
        {
          "name": "Scan Item - MacBook Pro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"43N23P\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/checkout/scan",
              "host": ["{{baseUrl}}"],
              "path": ["checkout", "scan"]
            },
            "description": "Add MacBook Pro ($5,399.99) to cart. Includes free Raspberry Pi!"
          }
        },
        {
          "name": "Scan Item - Alexa Speaker",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"A304SD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/checkout/scan",
              "host": ["{{baseUrl}}"],
              "path": ["checkout", "scan"]
            },
            "description": "Add Alexa Speaker ($109.50) to cart. Buy more than 3 for 10% off!"
          }
        },
        {
          "name": "Scan Item - Raspberry Pi",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"344222\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/checkout/scan",
              "host": ["{{baseUrl}}"],
              "path": ["checkout", "scan"]
            },
            "description": "Add Raspberry Pi ($30.00) to cart"
          }
        },
        {
          "name": "View Cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/checkout/cart",
              "host": ["{{baseUrl}}"],
              "path": ["checkout", "cart"]
            },
            "description": "View all items currently in the cart"
          }
        },
        {
          "name": "Get Total",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/checkout/total",
              "host": ["{{baseUrl}}"],
              "path": ["checkout", "total"]
            },
            "description": "Calculate total with all applicable discounts"
          }
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/checkout/clear",
              "host": ["{{baseUrl}}"],
              "path": ["checkout", "clear"]
            },
            "description": "Remove all items from the cart"
          }
        }
      ]
    },
